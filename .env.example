# --- Speech (required) -------------------------------------------------------
DEEPGRAM_API_KEY=

# --- LLM (one of the two providers, matching LLM_PROVIDER) -------------------
# Default provider is anthropic with claude-haiku-4-5 (fastest TTFT for voice).
ANTHROPIC_API_KEY=
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5

# Alternative:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# --- LiveKit (required for browser demo; NOT needed for console mode) --------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Mock reservation API ----------------------------------------------------
RESERVATION_API_URL=http://localhost:8000

# --- Optional tuning ---------------------------------------------------------
# DEEPGRAM_TTS_MODEL=aura-2-thalia-en
