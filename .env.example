# --- Speech (required) -------------------------------------------------------
DEEPGRAM_API_KEY=

# --- LLM (provider auto-detected from whichever key you set) -----------------
# Gemini:
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=

# Alternatives:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
#
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5
# ANTHROPIC_API_KEY=

# --- LiveKit (required for browser demo; NOT needed for console mode) --------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Mock reservation API ----------------------------------------------------
RESERVATION_API_URL=http://127.0.0.1:8000

# --- Optional tuning ---------------------------------------------------------
# DEEPGRAM_TTS_MODEL=aura-2-thalia-en
