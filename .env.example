# --- Speech (required) -------------------------------------------------------
DEEPGRAM_API_KEY=

# --- LLM (OpenAI is the default; provider auto-detected from the key you set)
OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini

# Alternative provider:
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5

# --- LiveKit (required for browser demo; NOT needed for console mode) --------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Mock reservation API ----------------------------------------------------
RESERVATION_API_URL=http://localhost:8000

